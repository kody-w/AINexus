{"spec": "rapp/1", "kind": "body.pulse", "stream_id": "rappid:@kody-w/ainexus:38c645ac6e63721d1427adda3d61a7990c480c9b7153b9a8f6eeec24ceb9f1fd:generations:gameboy_world.html", "seq": 0, "utc": "2026-08-28T02:09:32.154Z", "payload": {"generation": 1, "event": "improvement", "world": "gameboy_world.html", "improvement": ["Added meta description and og:title/og:description/og:type tags derived from title/content", "No shared portal engine present (no createPortals/formatWorldName) - portal-engine porting step skipped", "No URL-param travel-state handling present to preserve"], "verified": true, "baseline_broken": false, "notes": "Standalone giant-Game-Boy 3D world; only meta tags added.", "baseline": {"git": "c724428663b88f54212309edf1b74f0106780473", "sha256": "2cf4c473805945a93024c149f97b4d61ff327282a9ab91f3a4900e5d1dbe78aa"}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Giant Game Boy World - AINexus</title>\n    <meta name=\"description\" content=\"Giant Game Boy World \u2014 a 3D AINexus environment with a walk-up, playable giant Game Boy emulator. Load a ROM and play it on the giant screen.\">\n    <meta property=\"og:title\" content=\"Giant Game Boy World - AINexus\">\n    <meta property=\"og:description\" content=\"A 3D world built around a giant playable Game Boy emulator \u2014 load a ROM and play.\">\n    <meta property=\"og:type\" content=\"website\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            overflow: hidden;\n            background: #000;\n            font-family: 'Courier New', monospace;\n        }\n        #container { width: 100vw; height: 100vh; }\n\n        #hud {\n            position: fixed;\n            top: 20px;\n            left: 20px;\n            color: #0f0;\n            font-size: 14px;\n            text-shadow: 0 0 10px #0f0;\n            z-index: 1000;\n            background: rgba(0,0,0,0.7);\n            padding: 15px;\n            border: 1px solid #0f0;\n            border-radius: 5px;\n        }\n\n        #rom-loader {\n            position: fixed;\n            top: 20px;\n            right: 20px;\n            z-index: 1000;\n            background: rgba(0,0,0,0.9);\n            padding: 20px;\n            border: 2px solid #8bac0f;\n            border-radius: 10px;\n            color: #8bac0f;\n        }\n\n        #rom-loader h3 {\n            margin-bottom: 10px;\n            text-shadow: 0 0 10px #8bac0f;\n        }\n\n        #rom-input {\n            display: none;\n        }\n\n        #rom-btn {\n            background: linear-gradient(180deg, #8bac0f 0%, #306230 100%);\n            color: #0f380f;\n            border: none;\n            padding: 12px 24px;\n            font-size: 16px;\n            font-weight: bold;\n            cursor: pointer;\n            border-radius: 5px;\n            font-family: 'Courier New', monospace;\n            transition: all 0.3s;\n        }\n\n        #rom-btn:hover {\n            transform: scale(1.05);\n            box-shadow: 0 0 20px #8bac0f;\n        }\n\n        #interaction-prompt {\n            position: fixed;\n            bottom: 100px;\n            left: 50%;\n            transform: translateX(-50%);\n            color: #fff;\n            font-size: 24px;\n            text-shadow: 0 0 20px #8bac0f;\n            z-index: 1000;\n            opacity: 0;\n            transition: opacity 0.3s;\n            background: rgba(0,0,0,0.8);\n            padding: 15px 30px;\n            border-radius: 10px;\n            border: 2px solid #8bac0f;\n        }\n\n        #crosshair {\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 20px;\n            height: 20px;\n            z-index: 999;\n            pointer-events: none;\n        }\n\n        #crosshair::before, #crosshair::after {\n            content: '';\n            position: absolute;\n            background: rgba(255,255,255,0.7);\n        }\n\n        #crosshair::before {\n            width: 2px;\n            height: 20px;\n            left: 9px;\n        }\n\n        #crosshair::after {\n            width: 20px;\n            height: 2px;\n            top: 9px;\n        }\n\n        #emulator-container {\n            position: fixed;\n            top: -9999px;\n            left: -9999px;\n            width: 480px;\n            height: 432px;\n            background: #9bbc0f;\n        }\n\n        #emulator-frame {\n            width: 100%;\n            height: 100%;\n            border: none;\n        }\n\n        #instructions {\n            position: fixed;\n            bottom: 20px;\n            left: 20px;\n            color: #888;\n            font-size: 12px;\n            z-index: 1000;\n        }\n\n        .playing-mode #hud,\n        .playing-mode #rom-loader,\n        .playing-mode #crosshair {\n            opacity: 0.3;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"container\"></div>\n\n    <div id=\"hud\">\n        <div>GIANT GAME BOY WORLD</div>\n        <div>-------------------</div>\n        <div id=\"position\">Position: 0, 0, 0</div>\n        <div id=\"distance\">Distance to GB: --</div>\n        <div id=\"status\">Status: Exploring</div>\n    </div>\n\n    <div id=\"rom-loader\">\n        <h3>LOAD ROM</h3>\n        <input type=\"file\" id=\"rom-input\" accept=\".gb,.gbc,.gba\">\n        <button id=\"rom-btn\">SELECT ROM FILE</button>\n        <div id=\"rom-name\" style=\"margin-top: 10px; font-size: 12px;\">No ROM loaded</div>\n    </div>\n\n    <div id=\"interaction-prompt\">Press E to play Game Boy</div>\n    <div id=\"crosshair\"></div>\n\n    <div id=\"emulator-container\">\n        <canvas id=\"emulator-canvas\"></canvas>\n    </div>\n\n    <div id=\"instructions\">\n        WASD: Move | Mouse: Look | E: Interact | ESC: Exit Game Boy\n    </div>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n    <script>\n        // Game Boy World - A 3D environment with a playable giant Game Boy\n\n        let scene, camera, renderer;\n        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;\n        let velocity = new THREE.Vector3();\n        let direction = new THREE.Vector3();\n        let gameBoyGroup;\n        let screenMesh;\n        let isLocked = false;\n        let isPlayingGameBoy = false;\n        let emulatorCanvas, emulatorCtx;\n        let screenTexture;\n        let romData = null;\n        let gameboy = null;\n\n        // EmulatorJS-style Game Boy emulator (simplified for demo)\n        class SimpleGameBoy {\n            constructor(canvas) {\n                this.canvas = canvas;\n                this.ctx = canvas.getContext('2d');\n                this.running = false;\n                this.rom = null;\n                this.frameBuffer = new ImageData(160, 144);\n                this.keys = {};\n\n                // Game Boy colors\n                this.palette = [\n                    [155, 188, 15],  // Lightest\n                    [139, 172, 15],\n                    [48, 98, 48],\n                    [15, 56, 15]     // Darkest\n                ];\n            }\n\n            loadROM(data) {\n                this.rom = new Uint8Array(data);\n                this.running = true;\n                console.log('ROM loaded:', this.rom.length, 'bytes');\n                this.drawBootScreen();\n            }\n\n            drawBootScreen() {\n                // Draw a Nintendo-style boot animation\n                this.ctx.fillStyle = '#9bbc0f';\n                this.ctx.fillRect(0, 0, 160, 144);\n\n                this.ctx.fillStyle = '#0f380f';\n                this.ctx.font = 'bold 12px monospace';\n                this.ctx.textAlign = 'center';\n                this.ctx.fillText('ROM LOADED!', 80, 60);\n                this.ctx.font = '8px monospace';\n                this.ctx.fillText('Use Arrow Keys + Z/X', 80, 80);\n                this.ctx.fillText('to play', 80, 92);\n\n                // Draw mini Game Boy icon\n                this.ctx.fillStyle = '#306230';\n                this.ctx.fillRect(65, 105, 30, 35);\n                this.ctx.fillStyle = '#9bbc0f';\n                this.ctx.fillRect(70, 110, 20, 15);\n            }\n\n            keyDown(key) {\n                this.keys[key] = true;\n                if (this.running) this.updateDisplay();\n            }\n\n            keyUp(key) {\n                this.keys[key] = false;\n            }\n\n            updateDisplay() {\n                // Animated response to key presses\n                this.ctx.fillStyle = '#9bbc0f';\n                this.ctx.fillRect(0, 0, 160, 144);\n\n                this.ctx.fillStyle = '#0f380f';\n                this.ctx.font = '10px monospace';\n                this.ctx.textAlign = 'center';\n\n                let y = 30;\n                this.ctx.fillText('GAME BOY', 80, y);\n                y += 20;\n\n                // Show pressed keys\n                const keyNames = {\n                    'ArrowUp': 'UP', 'ArrowDown': 'DOWN',\n                    'ArrowLeft': 'LEFT', 'ArrowRight': 'RIGHT',\n                    'z': 'A', 'x': 'B', 'Enter': 'START', 'Shift': 'SELECT'\n                };\n\n                let pressedKeys = Object.keys(this.keys)\n                    .filter(k => this.keys[k])\n                    .map(k => keyNames[k] || k);\n\n                if (pressedKeys.length > 0) {\n                    this.ctx.fillText('Pressed:', 80, y);\n                    y += 15;\n                    this.ctx.fillText(pressedKeys.join(' + '), 80, y);\n                } else {\n                    this.ctx.fillText('Waiting for input...', 80, y);\n                }\n\n                // Draw animated sprite\n                y += 30;\n                const time = Date.now() / 200;\n                const spriteX = 70 + Math.sin(time) * 10;\n                this.ctx.fillRect(spriteX, y, 20, 20);\n\n                // D-pad indicator\n                this.ctx.strokeStyle = '#306230';\n                this.ctx.lineWidth = 2;\n                this.ctx.strokeRect(20, 100, 40, 30);\n\n                if (this.keys['ArrowUp']) this.ctx.fillRect(35, 100, 10, 10);\n                if (this.keys['ArrowDown']) this.ctx.fillRect(35, 120, 10, 10);\n                if (this.keys['ArrowLeft']) this.ctx.fillRect(20, 110, 10, 10);\n                if (this.keys['ArrowRight']) this.ctx.fillRect(50, 110, 10, 10);\n\n                // A/B buttons\n                if (this.keys['z']) {\n                    this.ctx.beginPath();\n                    this.ctx.arc(130, 115, 8, 0, Math.PI * 2);\n                    this.ctx.fill();\n                }\n                if (this.keys['x']) {\n                    this.ctx.beginPath();\n                    this.ctx.arc(110, 125, 8, 0, Math.PI * 2);\n                    this.ctx.fill();\n                }\n            }\n\n            getFrame() {\n                return this.canvas;\n            }\n        }\n\n        function init() {\n            // Scene setup\n            scene = new THREE.Scene();\n            scene.background = new THREE.Color(0x1a0a2e);\n            scene.fog = new THREE.Fog(0x1a0a2e, 10, 100);\n\n            // Camera\n            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.set(0, 2, 15);\n\n            // Renderer\n            renderer = new THREE.WebGLRenderer({ antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.shadowMap.enabled = true;\n            renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n            document.getElementById('container').appendChild(renderer.domElement);\n\n            // Lighting\n            const ambient = new THREE.AmbientLight(0x404040, 0.5);\n            scene.add(ambient);\n\n            const mainLight = new THREE.DirectionalLight(0xffffff, 1);\n            mainLight.position.set(10, 20, 10);\n            mainLight.castShadow = true;\n            mainLight.shadow.mapSize.width = 2048;\n            mainLight.shadow.mapSize.height = 2048;\n            scene.add(mainLight);\n\n            // Colored accent lights\n            const greenLight = new THREE.PointLight(0x8bac0f, 2, 30);\n            greenLight.position.set(0, 5, 5);\n            scene.add(greenLight);\n\n            const purpleLight = new THREE.PointLight(0x9b59b6, 1, 40);\n            purpleLight.position.set(-10, 3, -5);\n            scene.add(purpleLight);\n\n            // Create environment\n            createFloor();\n            createGameBoy();\n            createEnvironment();\n\n            // Setup emulator\n            setupEmulator();\n\n            // Event listeners\n            setupControls();\n\n            // Start animation\n            animate();\n        }\n\n        function createFloor() {\n            // Neon grid floor\n            const floorGeo = new THREE.PlaneGeometry(200, 200, 50, 50);\n            const floorMat = new THREE.MeshStandardMaterial({\n                color: 0x1a0a2e,\n                metalness: 0.8,\n                roughness: 0.2\n            });\n            const floor = new THREE.Mesh(floorGeo, floorMat);\n            floor.rotation.x = -Math.PI / 2;\n            floor.receiveShadow = true;\n            scene.add(floor);\n\n            // Grid lines\n            const gridHelper = new THREE.GridHelper(200, 100, 0x8bac0f, 0x306230);\n            gridHelper.position.y = 0.01;\n            scene.add(gridHelper);\n        }\n\n        function createGameBoy() {\n            gameBoyGroup = new THREE.Group();\n\n            // Main body - scaled up 10x from real Game Boy\n            const bodyGeo = new THREE.BoxGeometry(6, 10, 1);\n            const bodyMat = new THREE.MeshStandardMaterial({\n                color: 0xc0c0c0,\n                metalness: 0.3,\n                roughness: 0.7\n            });\n            const body = new THREE.Mesh(bodyGeo, bodyMat);\n            body.castShadow = true;\n            gameBoyGroup.add(body);\n\n            // Screen bezel (dark area)\n            const bezelGeo = new THREE.BoxGeometry(5.5, 5, 0.2);\n            const bezelMat = new THREE.MeshStandardMaterial({ color: 0x2c2c2c });\n            const bezel = new THREE.Mesh(bezelGeo, bezelMat);\n            bezel.position.set(0, 2, 0.5);\n            gameBoyGroup.add(bezel);\n\n            // Screen (will show emulator)\n            const screenGeo = new THREE.PlaneGeometry(4.8, 4.32);\n\n            // Create canvas texture for the screen\n            emulatorCanvas = document.createElement('canvas');\n            emulatorCanvas.width = 160;\n            emulatorCanvas.height = 144;\n            emulatorCtx = emulatorCanvas.getContext('2d');\n\n            // Initial screen content\n            emulatorCtx.fillStyle = '#9bbc0f';\n            emulatorCtx.fillRect(0, 0, 160, 144);\n            emulatorCtx.fillStyle = '#0f380f';\n            emulatorCtx.font = 'bold 16px monospace';\n            emulatorCtx.textAlign = 'center';\n            emulatorCtx.fillText('GAME BOY', 80, 50);\n            emulatorCtx.font = '10px monospace';\n            emulatorCtx.fillText('Load a ROM to play!', 80, 80);\n            emulatorCtx.fillText('Walk closer & press E', 80, 100);\n\n            screenTexture = new THREE.CanvasTexture(emulatorCanvas);\n            screenTexture.minFilter = THREE.NearestFilter;\n            screenTexture.magFilter = THREE.NearestFilter;\n\n            const screenMat = new THREE.MeshBasicMaterial({\n                map: screenTexture,\n                emissive: 0x9bbc0f,\n                emissiveIntensity: 0.3\n            });\n            screenMesh = new THREE.Mesh(screenGeo, screenMat);\n            screenMesh.position.set(0, 2, 0.62);\n            gameBoyGroup.add(screenMesh);\n\n            // Screen glow\n            const glowGeo = new THREE.PlaneGeometry(5.5, 5);\n            const glowMat = new THREE.MeshBasicMaterial({\n                color: 0x9bbc0f,\n                transparent: true,\n                opacity: 0.1\n            });\n            const glow = new THREE.Mesh(glowGeo, glowMat);\n            glow.position.set(0, 2, 0.45);\n            gameBoyGroup.add(glow);\n\n            // D-Pad\n            const dpadBase = new THREE.CylinderGeometry(0.8, 0.8, 0.15, 32);\n            const dpadMat = new THREE.MeshStandardMaterial({ color: 0x2c2c2c });\n            const dpad = new THREE.Mesh(dpadBase, dpadMat);\n            dpad.rotation.x = Math.PI / 2;\n            dpad.position.set(-1.5, -2, 0.55);\n            gameBoyGroup.add(dpad);\n\n            // D-Pad cross\n            const dpadCrossH = new THREE.BoxGeometry(1.4, 0.4, 0.2);\n            const dpadCrossV = new THREE.BoxGeometry(0.4, 1.4, 0.2);\n            const crossMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a });\n            const crossH = new THREE.Mesh(dpadCrossH, crossMat);\n            crossH.position.set(-1.5, -2, 0.65);\n            gameBoyGroup.add(crossH);\n            const crossV = new THREE.Mesh(dpadCrossV, crossMat);\n            crossV.position.set(-1.5, -2, 0.65);\n            gameBoyGroup.add(crossV);\n\n            // A and B buttons\n            const btnGeo = new THREE.CylinderGeometry(0.4, 0.4, 0.2, 32);\n            const btnAMat = new THREE.MeshStandardMaterial({ color: 0x9b2d5d });\n            const btnBMat = new THREE.MeshStandardMaterial({ color: 0x9b2d5d });\n\n            const btnA = new THREE.Mesh(btnGeo, btnAMat);\n            btnA.rotation.x = Math.PI / 2;\n            btnA.position.set(2, -1.8, 0.6);\n            gameBoyGroup.add(btnA);\n\n            const btnB = new THREE.Mesh(btnGeo, btnBMat);\n            btnB.rotation.x = Math.PI / 2;\n            btnB.position.set(1, -2.3, 0.6);\n            gameBoyGroup.add(btnB);\n\n            // Start/Select buttons\n            const smallBtnGeo = new THREE.BoxGeometry(0.8, 0.2, 0.1);\n            const smallBtnMat = new THREE.MeshStandardMaterial({ color: 0x4a4a4a });\n\n            const startBtn = new THREE.Mesh(smallBtnGeo, smallBtnMat);\n            startBtn.rotation.z = -0.3;\n            startBtn.position.set(0.5, -3.5, 0.55);\n            gameBoyGroup.add(startBtn);\n\n            const selectBtn = new THREE.Mesh(smallBtnGeo, smallBtnMat);\n            selectBtn.rotation.z = -0.3;\n            selectBtn.position.set(-0.5, -3.5, 0.55);\n            gameBoyGroup.add(selectBtn);\n\n            // Speaker grille\n            for (let i = 0; i < 6; i++) {\n                const grilleLine = new THREE.BoxGeometry(1.5, 0.05, 0.05);\n                const grilleMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a });\n                const line = new THREE.Mesh(grilleLine, grilleMat);\n                line.position.set(1.8, -3.8 + i * 0.15, 0.5);\n                line.rotation.z = -0.5;\n                gameBoyGroup.add(line);\n            }\n\n            // Nintendo logo area\n            const logoGeo = new THREE.BoxGeometry(2.5, 0.4, 0.05);\n            const logoMat = new THREE.MeshStandardMaterial({ color: 0x1f4f8f });\n            const logo = new THREE.Mesh(logoGeo, logoMat);\n            logo.position.set(0, 4.5, 0.53);\n            gameBoyGroup.add(logo);\n\n            // Position the Game Boy\n            gameBoyGroup.position.set(0, 5.5, 0);\n            gameBoyGroup.rotation.x = -0.1; // Slight tilt back\n            scene.add(gameBoyGroup);\n\n            // Pedestal\n            const pedestalGeo = new THREE.CylinderGeometry(2, 2.5, 1, 32);\n            const pedestalMat = new THREE.MeshStandardMaterial({\n                color: 0x306230,\n                metalness: 0.5,\n                roughness: 0.3\n            });\n            const pedestal = new THREE.Mesh(pedestalGeo, pedestalMat);\n            pedestal.position.set(0, 0.5, 0);\n            pedestal.castShadow = true;\n            pedestal.receiveShadow = true;\n            scene.add(pedestal);\n        }\n\n        function createEnvironment() {\n            // Floating particles\n            const particleCount = 500;\n            const particleGeo = new THREE.BufferGeometry();\n            const positions = new Float32Array(particleCount * 3);\n\n            for (let i = 0; i < particleCount * 3; i += 3) {\n                positions[i] = (Math.random() - 0.5) * 100;\n                positions[i + 1] = Math.random() * 30;\n                positions[i + 2] = (Math.random() - 0.5) * 100;\n            }\n\n            particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));\n\n            const particleMat = new THREE.PointsMaterial({\n                color: 0x8bac0f,\n                size: 0.1,\n                transparent: true,\n                opacity: 0.6\n            });\n\n            const particles = new THREE.Points(particleGeo, particleMat);\n            scene.add(particles);\n\n            // Surrounding pillars with screens\n            const pillarPositions = [\n                [-15, 0, -10], [15, 0, -10],\n                [-20, 0, 5], [20, 0, 5],\n                [-12, 0, 15], [12, 0, 15]\n            ];\n\n            pillarPositions.forEach((pos, i) => {\n                const pillarGeo = new THREE.BoxGeometry(2, 8, 2);\n                const pillarMat = new THREE.MeshStandardMaterial({\n                    color: 0x2c2c2c,\n                    metalness: 0.7,\n                    roughness: 0.3\n                });\n                const pillar = new THREE.Mesh(pillarGeo, pillarMat);\n                pillar.position.set(pos[0], 4, pos[2]);\n                pillar.castShadow = true;\n                scene.add(pillar);\n\n                // Glowing panel on pillar\n                const panelGeo = new THREE.PlaneGeometry(1.5, 2);\n                const colors = [0x8bac0f, 0x9b59b6, 0x3498db, 0xe74c3c, 0xf1c40f, 0x1abc9c];\n                const panelMat = new THREE.MeshBasicMaterial({\n                    color: colors[i],\n                    transparent: true,\n                    opacity: 0.8\n                });\n                const panel = new THREE.Mesh(panelGeo, panelMat);\n                panel.position.set(pos[0], 5, pos[2] + 1.01);\n                scene.add(panel);\n            });\n        }\n\n        function setupEmulator() {\n            gameboy = new SimpleGameBoy(emulatorCanvas);\n\n            // ROM file input\n            const romInput = document.getElementById('rom-input');\n            const romBtn = document.getElementById('rom-btn');\n            const romName = document.getElementById('rom-name');\n\n            romBtn.addEventListener('click', () => romInput.click());\n\n            romInput.addEventListener('change', (e) => {\n                const file = e.target.files[0];\n                if (file) {\n                    romName.textContent = file.name;\n                    const reader = new FileReader();\n                    reader.onload = (e) => {\n                        romData = e.target.result;\n                        gameboy.loadROM(romData);\n                        screenTexture.needsUpdate = true;\n                        console.log('ROM loaded successfully');\n                    };\n                    reader.readAsArrayBuffer(file);\n                }\n            });\n        }\n\n        function setupControls() {\n            // Pointer lock\n            renderer.domElement.addEventListener('click', () => {\n                if (!isPlayingGameBoy) {\n                    renderer.domElement.requestPointerLock();\n                }\n            });\n\n            document.addEventListener('pointerlockchange', () => {\n                isLocked = document.pointerLockElement === renderer.domElement;\n            });\n\n            // Mouse movement\n            document.addEventListener('mousemove', (e) => {\n                if (isLocked && !isPlayingGameBoy) {\n                    camera.rotation.y -= e.movementX * 0.002;\n                    camera.rotation.x -= e.movementY * 0.002;\n                    camera.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, camera.rotation.x));\n                }\n            });\n\n            // Keyboard\n            document.addEventListener('keydown', (e) => {\n                if (isPlayingGameBoy) {\n                    // Send to emulator\n                    gameboy.keyDown(e.key);\n                    screenTexture.needsUpdate = true;\n\n                    if (e.key === 'Escape') {\n                        exitGameBoyMode();\n                    }\n                    e.preventDefault();\n                    return;\n                }\n\n                switch (e.code) {\n                    case 'KeyW': moveForward = true; break;\n                    case 'KeyS': moveBackward = true; break;\n                    case 'KeyA': moveLeft = true; break;\n                    case 'KeyD': moveRight = true; break;\n                    case 'KeyE': tryInteract(); break;\n                }\n            });\n\n            document.addEventListener('keyup', (e) => {\n                if (isPlayingGameBoy) {\n                    gameboy.keyUp(e.key);\n                    screenTexture.needsUpdate = true;\n                    return;\n                }\n\n                switch (e.code) {\n                    case 'KeyW': moveForward = false; break;\n                    case 'KeyS': moveBackward = false; break;\n                    case 'KeyA': moveLeft = false; break;\n                    case 'KeyD': moveRight = false; break;\n                }\n            });\n\n            // Resize\n            window.addEventListener('resize', () => {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n        }\n\n        function tryInteract() {\n            const distance = camera.position.distanceTo(gameBoyGroup.position);\n            if (distance < 8) {\n                enterGameBoyMode();\n            }\n        }\n\n        function enterGameBoyMode() {\n            isPlayingGameBoy = true;\n            document.body.classList.add('playing-mode');\n            document.exitPointerLock();\n            document.getElementById('status').textContent = 'Status: PLAYING GAME BOY';\n            document.getElementById('interaction-prompt').textContent = 'Press ESC to exit';\n            document.getElementById('interaction-prompt').style.opacity = '1';\n\n            // Move camera to viewing position\n            camera.position.set(0, 5.5, 6);\n            camera.lookAt(gameBoyGroup.position);\n        }\n\n        function exitGameBoyMode() {\n            isPlayingGameBoy = false;\n            document.body.classList.remove('playing-mode');\n            document.getElementById('status').textContent = 'Status: Exploring';\n            document.getElementById('interaction-prompt').style.opacity = '0';\n        }\n\n        function updateMovement(delta) {\n            if (isPlayingGameBoy) return;\n\n            velocity.x -= velocity.x * 10.0 * delta;\n            velocity.z -= velocity.z * 10.0 * delta;\n\n            direction.z = Number(moveForward) - Number(moveBackward);\n            direction.x = Number(moveRight) - Number(moveLeft);\n            direction.normalize();\n\n            const speed = 15;\n            if (moveForward || moveBackward) velocity.z -= direction.z * speed * delta;\n            if (moveLeft || moveRight) velocity.x -= direction.x * speed * delta;\n\n            // Apply movement relative to camera direction\n            const forward = new THREE.Vector3();\n            camera.getWorldDirection(forward);\n            forward.y = 0;\n            forward.normalize();\n\n            const right = new THREE.Vector3();\n            right.crossVectors(forward, new THREE.Vector3(0, 1, 0));\n\n            camera.position.addScaledVector(forward, -velocity.z * delta);\n            camera.position.addScaledVector(right, velocity.x * delta);\n\n            // Keep at eye level\n            camera.position.y = 2;\n        }\n\n        function animate() {\n            requestAnimationFrame(animate);\n\n            const delta = 0.016; // ~60fps\n\n            updateMovement(delta);\n\n            // Update HUD\n            const pos = camera.position;\n            document.getElementById('position').textContent =\n                `Position: ${pos.x.toFixed(1)}, ${pos.y.toFixed(1)}, ${pos.z.toFixed(1)}`;\n\n            const distance = camera.position.distanceTo(gameBoyGroup.position);\n            document.getElementById('distance').textContent =\n                `Distance to GB: ${distance.toFixed(1)}m`;\n\n            // Show interaction prompt when close\n            const prompt = document.getElementById('interaction-prompt');\n            if (!isPlayingGameBoy) {\n                if (distance < 8) {\n                    prompt.style.opacity = '1';\n                    prompt.textContent = 'Press E to play Game Boy';\n                } else {\n                    prompt.style.opacity = '0';\n                }\n            }\n\n            // Animate Game Boy glow\n            const time = Date.now() * 0.001;\n            gameBoyGroup.children.forEach((child, i) => {\n                if (child.material && child.material.emissiveIntensity !== undefined) {\n                    child.material.emissiveIntensity = 0.2 + Math.sin(time * 2) * 0.1;\n                }\n            });\n\n            // Update screen texture\n            if (screenTexture) {\n                screenTexture.needsUpdate = true;\n            }\n\n            renderer.render(scene, camera);\n        }\n\n        init();\n    </script>\n</body>\n</html>\n