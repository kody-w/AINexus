{"spec": "rapp/1", "kind": "body.pulse", "stream_id": "rappid:@kody-w/ainexus:38c645ac6e63721d1427adda3d61a7990c480c9b7153b9a8f6eeec24ceb9f1fd:generations:brian-tracy-list.html", "seq": 0, "utc": "2026-08-28T02:09:31.454Z", "payload": {"generation": 1, "event": "improvement", "world": "brian-tracy-list.html", "improvement": ["Added meta description and og:title/og:description/og:type tags derived from the page's own h1/subtitle content (Brian Tracy's task-list method)"], "verified": true, "baseline_broken": false, "notes": "No shared portal engine present \u2014 meta-tag-only change.", "baseline": {"git": "c724428663b88f54212309edf1b74f0106780473", "sha256": "420f1518721860d9e2af7cf910e210d10bdb8385c2ec82f7d651f119bb24979e"}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Brian Tracy's Focus List</title>\n    <meta name=\"description\" content=\"A task list built on Brian Tracy's method: make a list for everything, sort it, and export or import your tasks as markdown.\">\n    <meta property=\"og:title\" content=\"Brian Tracy's Focus List\">\n    <meta property=\"og:description\" content=\"A task list built on Brian Tracy's method: make a list for everything, sort it, and export or import your tasks as markdown.\">\n    <meta property=\"og:type\" content=\"website\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --bg-color: #f8fafc;\n            --card-bg: #ffffff;\n            --primary: #4f46e5;\n            --primary-hover: #4338ca;\n            --text-main: #1e293b;\n            --text-muted: #64748b;\n            --border: #e2e8f0;\n            --danger: #ef4444;\n            --success: #22c55e;\n            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);\n        }\n\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-main);\n            margin: 0;\n            padding: 0;\n            line-height: 1.5;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            /* Legacy container, now using layout-wrapper inline but keeping this for fallback/inner spacing */\n            width: 100%;\n        }\n\n        /* Sidebar Styles */\n        .sidebar-item {\n            padding: 0.75rem 1rem;\n            margin-bottom: 0.5rem;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: background-color 0.2s, color 0.2s;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            color: var(--text-muted);\n            font-weight: 500;\n        }\n\n        .sidebar-item:hover {\n            background-color: #f1f5f9;\n            color: var(--text-main);\n        }\n\n        .sidebar-item.active {\n            background-color: #e0e7ff;\n            color: var(--primary);\n        }\n\n        .sidebar-name {\n            flex: 1;\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n        }\n\n        .delete-list-btn {\n            background: none;\n            border: none;\n            color: #94a3b8;\n            cursor: pointer;\n            font-size: 1.25rem;\n            line-height: 1;\n            padding: 0 0.25rem;\n            opacity: 0;\n            transition: opacity 0.2s, color 0.2s;\n        }\n\n        .sidebar-item:hover .delete-list-btn {\n            opacity: 1;\n        }\n\n        .delete-list-btn:hover {\n            color: var(--danger);\n        }\n\n        header {\n            text-align: center;\n            margin-bottom: 2rem;\n        }\n\n        /* Adjust header for main content area */\n        main header {\n            text-align: left;\n        }\n\n        h1 {\n            font-size: 2.25rem;\n            font-weight: 700;\n            color: var(--text-main);\n            margin-bottom: 0.5rem;\n            letter-spacing: -0.025em;\n        }\n\n        p.subtitle {\n            color: var(--text-muted);\n            font-size: 1.125rem;\n        }\n\n        .card {\n            background: var(--card-bg);\n            border-radius: 12px;\n            box-shadow: var(--shadow-md);\n            border: 1px solid var(--border);\n            overflow: hidden;\n        }\n\n        .input-group {\n            padding: 1.5rem;\n            background: #fff;\n            border-bottom: 1px solid var(--border);\n            display: flex;\n            gap: 0.75rem;\n        }\n\n        input[type=\"text\"] {\n            flex: 1;\n            padding: 0.75rem 1rem;\n            border: 1px solid var(--border);\n            border-radius: 8px;\n            font-size: 1rem;\n            transition: border-color 0.2s, box-shadow 0.2s;\n        }\n\n        input[type=\"text\"]:focus {\n            outline: none;\n            border-color: var(--primary);\n            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);\n        }\n\n        button.add-btn {\n            background-color: var(--primary);\n            color: white;\n            border: none;\n            padding: 0.75rem 1.5rem;\n            border-radius: 8px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: background-color 0.2s;\n        }\n\n        button.add-btn:hover {\n            background-color: var(--primary-hover);\n        }\n\n        .list-container {\n            padding: 0;\n            list-style: none;\n            margin: 0;\n        }\n\n        .task-item {\n            display: flex;\n            align-items: center;\n            padding: 1rem 1.5rem;\n            border-bottom: 1px solid var(--border);\n            transition: background-color 0.1s;\n        }\n\n        .task-item:last-child {\n            border-bottom: none;\n        }\n\n        .task-item:hover {\n            background-color: #f9fafb;\n        }\n\n        .task-checkbox {\n            margin-right: 1rem;\n            width: 1.25rem;\n            height: 1.25rem;\n            cursor: pointer;\n            accent-color: var(--primary);\n        }\n\n        .task-content {\n            flex: 1;\n        }\n\n        .task-text {\n            font-size: 1rem;\n            font-weight: 500;\n        }\n\n        .task-meta {\n            font-size: 0.875rem;\n            color: var(--text-muted);\n            margin-top: 0.25rem;\n        }\n\n        .task-actions {\n            display: flex;\n            gap: 0.5rem;\n            opacity: 0;\n            transition: opacity 0.2s;\n        }\n\n        .task-item:hover .task-actions {\n            opacity: 1;\n        }\n\n        .priority-select {\n            padding: 0.25rem 0.5rem;\n            border-radius: 6px;\n            border: 1px solid var(--border);\n            font-size: 0.875rem;\n            background-color: white;\n            cursor: pointer;\n        }\n\n        .btn-icon {\n            background: none;\n            border: none;\n            color: var(--text-muted);\n            cursor: pointer;\n            padding: 0.25rem;\n            border-radius: 4px;\n            transition: color 0.2s, background-color 0.2s;\n        }\n\n        .btn-icon:hover {\n            background-color: #f1f5f9;\n            color: var(--danger);\n        }\n\n        .priority-badge {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            width: 24px;\n            height: 24px;\n            border-radius: 50%;\n            font-size: 0.75rem;\n            font-weight: 700;\n            margin-right: 0.75rem;\n            flex-shrink: 0;\n        }\n\n        .priority-A {\n            background-color: #fee2e2;\n            color: #b91c1c;\n        }\n\n        .priority-B {\n            background-color: #ffedd5;\n            color: #c2410c;\n        }\n\n        .priority-C {\n            background-color: #fef9c3;\n            color: #a16207;\n        }\n\n        .priority-D {\n            background-color: #ecfccb;\n            color: #4d7c0f;\n        }\n\n        .priority-E {\n            background-color: #f1f5f9;\n            color: #64748b;\n        }\n\n        .completed .task-text {\n            text-decoration: line-through;\n            color: var(--text-muted);\n        }\n\n        .empty-state {\n            padding: 3rem;\n            text-align: center;\n            color: var(--text-muted);\n        }\n\n        .section-title {\n            margin: 2rem 0 1rem;\n            font-size: 1.25rem;\n            font-weight: 600;\n            color: var(--text-main);\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n        }\n\n        .controls {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .sort-btn {\n            background: none;\n            border: 1px solid var(--border);\n            padding: 0.5rem 1rem;\n            border-radius: 6px;\n            font-size: 0.875rem;\n            cursor: pointer;\n            color: var(--text-muted);\n        }\n\n        .sort-btn:hover {\n            background: white;\n            color: var(--primary);\n            border-color: var(--primary);\n        }\n    </style>\n</head>\n\n<body>\n\n    <div class=\"layout-wrapper\"\n        style=\"display: flex; gap: 2rem; max-width: 1000px; margin: 2rem auto; padding: 0 1rem;\">\n        <!-- Sidebar -->\n        <aside style=\"width: 250px; flex-shrink: 0;\">\n            <div class=\"card\" style=\"padding: 1rem; height: 100%; min-height: 400px;\">\n                <h3\n                    style=\"margin-top: 0; font-size: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;\">\n                    Your Lists</h3>\n                <ul id=\"sidebarList\" style=\"list-style: none; padding: 0; margin: 1rem 0;\">\n                    <!-- Lists injected here -->\n                </ul>\n                <button class=\"add-btn\" style=\"width: 100%; font-size: 0.875rem;\" onclick=\"createNewList()\">+ New\n                    List</button>\n            </div>\n        </aside>\n\n        <!-- Main Content -->\n        <main style=\"flex: 1;\">\n            <header style=\"text-align: left; margin-bottom: 2rem;\">\n                <h1>Make a List for Everything</h1>\n                <p class=\"subtitle\">Brian Tracy's Method</p>\n            </header>\n\n            <div class=\"card\">\n                <div class=\"input-group\">\n                    <input type=\"text\" id=\"newTaskInput\" placeholder=\"What needs to be done?\">\n                    <button class=\"add-btn\" onclick=\"addTask()\">Add Task</button>\n                </div>\n\n                <div class=\"controls\"\n                    style=\"padding: 1rem 1.5rem; background: #fafafa; border-bottom: 1px solid var(--border); justify-content: space-between;\">\n                    <span id=\"listTitle\"\n                        style=\"font-weight: 600; color: var(--text-main); font-size: 1rem;\">TASKS</span>\n                    <div style=\"display: flex; gap: 0.5rem;\">\n                        <button class=\"sort-btn\" onclick=\"sortTasks()\">Sort</button>\n                        <button class=\"sort-btn\" onclick=\"exportToMarkdown()\">Export</button>\n                        <button class=\"sort-btn\" onclick=\"triggerImport()\">Import</button>\n                        <input type=\"file\" id=\"importFile\" accept=\".md,.txt\" style=\"display: none;\"\n                            onchange=\"importFromMarkdown(event)\">\n                    </div>\n                </div>\n\n                <ul class=\"list-container\" id=\"taskList\">\n                    <!-- Tasks will be injected here -->\n                </ul>\n            </div>\n    </div>\n\n    <script>\n        // --- DATA ---\n\n        const REHAB_TASKS = [\n            // Phase 1: Mobility & Release (Weeks 1-2)\n            { id: 'r1', text: \"[Phase 1] Pendulums: 1-2 min each direction\", priority: 'A', completed: false },\n            { id: 'r2', text: \"[Phase 1] Water Walking with Arm Swings: 3-5 min\", priority: 'A', completed: false },\n            { id: 'r3', text: \"[Phase 1] Wall Slides (Underwater): 2 sets of 10\", priority: 'A', completed: false },\n            { id: 'r4', text: \"[Phase 1] Floating Stretch: Hold 30-60 sec\", priority: 'A', completed: false },\n            { id: 'r5', text: \"[Phase 1] Cross-Body Pulls: Hold 20 sec, 5x each side\", priority: 'A', completed: false },\n\n            // Phase 2: Activation (Weeks 2-4)\n            { id: 'r6', text: \"[Phase 2] Figure 8s: 2 sets of 10 each arm\", priority: 'B', completed: false },\n            { id: 'r7', text: \"[Phase 2] Chest Fly / Reverse Fly: 2 sets of 12\", priority: 'B', completed: false },\n            { id: 'r8', text: \"[Phase 2] External Rotation: 2 sets of 12 each arm\", priority: 'B', completed: false },\n            { id: 'r9', text: \"[Phase 2] Arm Circles: 30 sec each direction\", priority: 'B', completed: false },\n            { id: 'r10', text: \"[Phase 2] Scapular Squeezes: 2 sets of 15\", priority: 'B', completed: false },\n            { id: 'r11', text: \"[Phase 2] Trunk Rotation: 2 sets of 10 each side\", priority: 'B', completed: false },\n            { id: 'r12', text: \"[Phase 2] Side Bends: Hold 10 sec, 5x\", priority: 'B', completed: false },\n            { id: 'r13', text: \"[Phase 2] Noodle Lat Stretch: Hold 30 sec\", priority: 'B', completed: false },\n\n            // Phase 3: Strengthening (Weeks 4-8)\n            { id: 'r14', text: \"[Phase 3] Paddle/Webbed Glove Work: 3 sets of 10-12\", priority: 'C', completed: false },\n            { id: 'r15', text: \"[Phase 3] Noodle Press: 3 sets of 12\", priority: 'C', completed: false },\n            { id: 'r16', text: \"[Phase 3] Kickboard Punches: 3 sets of 10 each arm\", priority: 'C', completed: false },\n            { id: 'r17', text: \"[Phase 3] Noodle Pull-Downs: 3 sets of 10\", priority: 'C', completed: false },\n\n            // Functional\n            { id: 'r18', text: \"[Functional] Walking with Resistance: 5 min total\", priority: 'D', completed: false },\n            { id: 'r19', text: \"[Functional] Deep Water Jogging: 5-10 min\", priority: 'D', completed: false },\n            { id: 'r20', text: \"[Functional] Swimming (Modified): 5-10 min, no freestyle\", priority: 'D', completed: false },\n\n            // Quick Session\n            { id: 'r21', text: \"[Quick Session] Water walking with swings (3 min)\", priority: 'E', completed: false },\n            { id: 'r22', text: \"[Quick Session] Pendulums (2 min)\", priority: 'E', completed: false },\n            { id: 'r23', text: \"[Quick Session] Figure 8s (2 min)\", priority: 'E', completed: false },\n            { id: 'r24', text: \"[Quick Session] Chest fly / reverse fly (2 sets)\", priority: 'E', completed: false },\n\n            // Equipment\n            { id: 'r25', text: \"[Equipment] Pool noodle, Kickboard\", priority: 'E', completed: false },\n            { id: 'r26', text: \"[Equipment] Webbed gloves, Aqua dumbbells\", priority: 'E', completed: false }\n        ];\n\n        const initialDefaultTasks = [\n            { id: '1', text: \"Write demo script for RAPP\", priority: \"A\", completed: false },\n            { id: '2', text: \"Film demo\", priority: \"A\", completed: false },\n            { id: '3', text: \"Edit demo\", priority: \"B\", completed: false },\n            { id: '4', text: \"Uploaded to clipchamp. Make final edits\", priority: \"B\", completed: false },\n            { id: '5', text: \"Hook up Sharepoint integration to agent\", priority: \"C\", completed: false }\n        ];\n\n        // Data Structure: { lists: [{id, name, tasks: []}], currentListId: string }\n        let appData = JSON.parse(localStorage.getItem('brianTracyAppData')) || null;\n\n        // Migration or Initialization\n        if (!appData) {\n            // Check for old legacy data\n            let oldTasks = JSON.parse(localStorage.getItem('brianTracyTasks')) || initialDefaultTasks;\n\n            appData = {\n                lists: [\n                    { id: 'default', name: 'Tasks for Tomorrow', tasks: oldTasks },\n                    { id: 'rehab', name: 'Aquatic Rehab Guide', tasks: REHAB_TASKS }\n                ],\n                currentListId: 'default'\n            };\n            saveData();\n        }\n\n        // Ensure Rehab list exists if user already has data but not this list (idempotency)\n        if (!appData.lists.find(l => l.id === 'rehab')) {\n            appData.lists.push({ id: 'rehab', name: 'Aquatic Rehab Guide', tasks: REHAB_TASKS });\n            saveData();\n        }\n\n        function saveData() {\n            localStorage.setItem('brianTracyAppData', JSON.stringify(appData));\n            renderApp();\n        }\n\n        function getCurrentList() {\n            return appData.lists.find(l => l.id === appData.currentListId) || appData.lists[0];\n        }\n\n        // --- RENDER ---\n\n        function renderApp() {\n            renderSidebar();\n            renderTasks();\n        }\n\n        function renderSidebar() {\n            const sidebarList = document.getElementById('sidebarList');\n            // If sidebar doesn't exist yet in DOM (will be added in HTML step), return\n            if (!sidebarList) return;\n\n            sidebarList.innerHTML = '';\n            appData.lists.forEach(list => {\n                const li = document.createElement('li');\n                li.className = `sidebar-item ${list.id === appData.currentListId ? 'active' : ''}`;\n                li.onclick = () => switchList(list.id);\n                li.innerHTML = `\n                <span class=\"sidebar-name\">${list.name}</span>\n                ${list.id !== 'default' && list.id !== 'rehab' ?\n                        `<button class=\"delete-list-btn\" onclick=\"deleteList('${list.id}', event)\">\u00d7</button>` : ''}\n            `;\n                sidebarList.appendChild(li);\n            });\n        }\n\n        function renderTasks() {\n            const currentList = getCurrentList();\n            document.getElementById('listTitle').textContent = currentList.name;\n\n            const listContainer = document.getElementById('taskList');\n            listContainer.innerHTML = '';\n\n            if (currentList.tasks.length === 0) {\n                listContainer.innerHTML = '<div class=\"empty-state\">No tasks. Add one or Import MD!</div>';\n                return;\n            }\n\n            currentList.tasks.forEach(task => {\n                const li = document.createElement('li');\n                li.className = `task-item ${task.completed ? 'completed' : ''}`;\n\n                li.innerHTML = `\n                <div class=\"priority-badge priority-${task.priority}\">${task.priority}</div>\n                <input type=\"checkbox\" class=\"task-checkbox\" ${task.completed ? 'checked' : ''} onchange=\"toggleTask('${task.id}')\">\n                <div class=\"task-content\">\n                    <div class=\"task-text\">${task.text}</div>\n                    <div class=\"task-meta\" style=\"font-size: 0.75rem; color: #94a3b8;\">${task.id.toString().startsWith('r') ? 'Guide Item' : ''}</div>\n                </div>\n                <div class=\"task-actions\">\n                    <select class=\"priority-select\" onchange=\"updatePriority('${task.id}', this.value)\" onclick=\"event.stopPropagation()\">\n                        <option value=\"A\" ${task.priority === 'A' ? 'selected' : ''}>A</option>\n                        <option value=\"B\" ${task.priority === 'B' ? 'selected' : ''}>B</option>\n                        <option value=\"C\" ${task.priority === 'C' ? 'selected' : ''}>C</option>\n                        <option value=\"D\" ${task.priority === 'D' ? 'selected' : ''}>D</option>\n                        <option value=\"E\" ${task.priority === 'E' ? 'selected' : ''}>E</option>\n                    </select>\n                    <button class=\"btn-icon\" onclick=\"deleteTask('${task.id}')\" title=\"Delete\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path></svg>\n                    </button>\n                </div>\n            `;\n                listContainer.appendChild(li);\n            });\n        }\n\n        // --- ACTIONS ---\n\n        function switchList(id) {\n            appData.currentListId = id;\n            saveData();\n        }\n\n        function createNewList() {\n            const name = prompt(\"Enter new list name:\");\n            if (name) {\n                const newList = {\n                    id: 'list_' + Date.now(),\n                    name: name,\n                    tasks: []\n                };\n                appData.lists.push(newList);\n                appData.currentListId = newList.id;\n                saveData();\n            }\n        }\n\n        function deleteList(id, event) {\n            event.stopPropagation();\n            if (confirm('Delete this list?')) {\n                appData.lists = appData.lists.filter(l => l.id !== id);\n                if (appData.currentListId === id) {\n                    appData.currentListId = appData.lists[0].id;\n                }\n                saveData();\n            }\n        }\n\n        function addTask() {\n            const input = document.getElementById('newTaskInput');\n            const text = input.value.trim();\n            if (!text) return;\n\n            const currentList = getCurrentList();\n            const newTask = {\n                id: Date.now().toString(),\n                text: text,\n                priority: 'C',\n                completed: false\n            };\n\n            currentList.tasks.push(newTask);\n            input.value = '';\n            saveData();\n        }\n\n        function toggleTask(id) {\n            const currentList = getCurrentList();\n            const task = currentList.tasks.find(t => t.id == id); // strict vs loose equality for string/number ids\n            if (task) {\n                task.completed = !task.completed;\n                saveData();\n            }\n        }\n\n        function updatePriority(id, newPriority) {\n            const currentList = getCurrentList();\n            const task = currentList.tasks.find(t => t.id == id);\n            if (task) {\n                task.priority = newPriority;\n                saveData();\n            }\n        }\n\n        function deleteTask(id) {\n            if (confirm('Delete task?')) {\n                const currentList = getCurrentList();\n                currentList.tasks = currentList.tasks.filter(t => t.id != id);\n                saveData();\n            }\n        }\n\n        function sortTasks() {\n            const currentList = getCurrentList();\n            const priorityOrder = { 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5 };\n            currentList.tasks.sort((a, b) => {\n                if (a.completed !== b.completed) return a.completed ? 1 : -1;\n                return priorityOrder[a.priority] - priorityOrder[b.priority];\n            });\n            saveData();\n        }\n\n        // --- Import / Export Logic (UPDATED) ---\n\n        function exportToMarkdown() {\n            const currentList = getCurrentList();\n            let mdContent = `# ${currentList.name}\\n\\n`;\n            currentList.tasks.forEach(task => {\n                const check = task.completed ? 'x' : ' ';\n                mdContent += `- [${check}] (${task.priority}) ${task.text}\\n`;\n            });\n\n            const blob = new Blob([mdContent], { type: 'text/markdown' });\n            const url = URL.createObjectURL(blob);\n            const a = document.createElement('a');\n            a.href = url;\n            a.download = `${currentList.name.replace(/\\s+/g, '_')}_${new Date().toISOString().slice(0, 10)}.md`;\n            document.body.appendChild(a);\n            a.click();\n            document.body.removeChild(a);\n            URL.revokeObjectURL(url);\n        }\n\n        // Import logic remains largely same but updates currentList\n        function parseMarkdown(md) {\n            const lines = md.split('\\n');\n            const newTasks = [];\n\n            lines.forEach(line => {\n                const match = line.match(/^- \\[([ xX])\\](?:\\s*\\(([ABCDE])\\))?\\s*(.*)$/);\n                if (match) {\n                    const isCompleted = match[1].toLowerCase() === 'x';\n                    const priority = match[2] ? match[2] : 'C';\n                    const text = match[3].trim();\n\n                    if (text) {\n                        newTasks.push({\n                            id: Date.now() + Math.random().toString(),\n                            text: text,\n                            priority: priority,\n                            completed: isCompleted\n                        });\n                    }\n                }\n            });\n\n            if (newTasks.length > 0) {\n                if (confirm(`Found ${newTasks.length} tasks. Replace current list?`)) {\n                    getCurrentList().tasks = newTasks;\n                    saveData();\n                    alert('Tasks imported successfully!');\n                }\n            } else {\n                alert('No valid tasks found.');\n            }\n        }\n\n        // Handle Enter key in input\n        document.getElementById('newTaskInput').addEventListener('keypress', function (e) {\n            if (e.key === 'Enter') {\n                addTask();\n            }\n        });\n\n        // Initial render\n        renderApp();\n    </script>\n\n</body>\n\n</html>", "html_sha256": "f4c2c2d5bf07952a8bae31cb47242a6c72855d2b0ad3451396ebb0e9164ed399", "live": "https://kody-w.github.io/AINexus/brian-tracy-list.html"}, "payload_hash": "f2f2ac8fa5d16b00c330c945568a0e08f35bd9b012993aed76c59b4070150dcb", "prev": null, "prev_wave": null, "sig": null, "frame_hash": "d5a99af634c1b2d48e758fd33759ccb0cf1c2a8ca08b7e91d15e1b2ac7fc367e"}
