{"spec": "rapp/1", "kind": "body.pulse", "stream_id": "rappid:@kody-w/ainexus:38c645ac6e63721d1427adda3d61a7990c480c9b7153b9a8f6eeec24ceb9f1fd:generations:record-review-app.html", "seq": 0, "utc": "2026-08-28T02:09:31.901Z", "payload": {"generation": 1, "event": "improvement", "world": "record-review-app.html", "improvement": ["Added meta description and og:title/og:description/og:type tags derived from the page's subtitle", "No shared portal engine present \u2014 step 2 not applicable", "No URL travel-state params present \u2014 nothing to preserve"], "verified": true, "baseline_broken": false, "notes": "Baseline was already ok:true; verified clean after edit, screenshot confirms normal render.", "baseline": {"git": "c724428663b88f54212309edf1b74f0106780473", "sha256": "8383315f2a7073df2f1b989f60148fc06e31ae7168193743490e906506254d4e"}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Record & Review - Communication Training</title>\n    <meta name=\"description\" content=\"Record & Review \u2014 transform your communication skills through video analysis: record a video, review it, and build a library of practice takes.\">\n    <meta property=\"og:title\" content=\"Record & Review - Communication Training\">\n    <meta property=\"og:description\" content=\"Transform your communication skills through video analysis.\">\n    <meta property=\"og:type\" content=\"website\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background: #0a0a0a;\n            color: #e0e0e0;\n            min-height: 100vh;\n            overflow-x: hidden;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem;\n        }\n\n        header {\n            text-align: center;\n            margin-bottom: 3rem;\n            position: relative;\n        }\n\n        h1 {\n            font-size: 3rem;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            margin-bottom: 1rem;\n            animation: fadeInDown 0.8s ease-out;\n        }\n\n        .subtitle {\n            font-size: 1.2rem;\n            color: #9ca3af;\n            animation: fadeInUp 0.8s ease-out 0.2s both;\n        }\n\n        .main-content {\n            display: grid;\n            gap: 2rem;\n            animation: fadeIn 1s ease-out 0.4s both;\n        }\n\n        .card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            border-radius: 20px;\n            padding: 2rem;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            transition: all 0.3s ease;\n        }\n\n        .card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);\n        }\n\n        .recording-section {\n            text-align: center;\n        }\n\n        #videoElement, #recordedVideo {\n            width: 100%;\n            max-width: 640px;\n            height: auto;\n            border-radius: 15px;\n            background: #000;\n            margin: 1rem auto;\n            display: block;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\n        }\n\n        .controls {\n            display: flex;\n            gap: 1rem;\n            justify-content: center;\n            flex-wrap: wrap;\n            margin: 2rem 0;\n        }\n\n        button {\n            padding: 0.8rem 2rem;\n            border: none;\n            border-radius: 50px;\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n        }\n\n        .btn-primary:hover {\n            transform: scale(1.05);\n            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);\n        }\n\n        .btn-secondary {\n            background: rgba(255, 255, 255, 0.1);\n            color: #e0e0e0;\n            backdrop-filter: blur(10px);\n        }\n\n        .btn-secondary:hover {\n            background: rgba(255, 255, 255, 0.2);\n        }\n\n        button:disabled {\n            opacity: 0.5;\n            cursor: not-allowed;\n        }\n\n        .timer {\n            font-size: 2rem;\n            font-weight: bold;\n            color: #667eea;\n            margin: 1rem 0;\n            font-variant-numeric: tabular-nums;\n        }\n\n        .analysis-section {\n            display: none;\n        }\n\n        .analysis-section.active {\n            display: block;\n        }\n\n        .tabs {\n            display: flex;\n            gap: 1rem;\n            margin-bottom: 2rem;\n            border-bottom: 2px solid rgba(255, 255, 255, 0.1);\n            overflow-x: auto;\n        }\n\n        .tab {\n            padding: 1rem 2rem;\n            background: none;\n            border: none;\n            color: #9ca3af;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            position: relative;\n            white-space: nowrap;\n        }\n\n        .tab:hover {\n            color: #e0e0e0;\n        }\n\n        .tab.active {\n            color: #667eea;\n        }\n\n        .tab.active::after {\n            content: '';\n            position: absolute;\n            bottom: -2px;\n            left: 0;\n            right: 0;\n            height: 2px;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        }\n\n        .tab-content {\n            display: none;\n            animation: fadeIn 0.5s ease-out;\n        }\n\n        .tab-content.active {\n            display: block;\n        }\n\n        .checklist {\n            list-style: none;\n            margin: 1rem 0;\n        }\n\n        .checklist li {\n            padding: 1rem;\n            margin: 0.5rem 0;\n            background: rgba(255, 255, 255, 0.03);\n            border-radius: 10px;\n            transition: all 0.3s ease;\n        }\n\n        .checklist li:hover {\n            background: rgba(255, 255, 255, 0.05);\n            transform: translateX(10px);\n        }\n\n        .transcription-area {\n            width: 100%;\n            min-height: 200px;\n            background: rgba(0, 0, 0, 0.3);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            border-radius: 10px;\n            padding: 1rem;\n            color: #e0e0e0;\n            font-family: 'Courier New', monospace;\n            resize: vertical;\n        }\n\n        .filler-words {\n            margin-top: 1rem;\n            padding: 1rem;\n            background: rgba(102, 126, 234, 0.1);\n            border-radius: 10px;\n            border: 1px solid rgba(102, 126, 234, 0.3);\n        }\n\n        .video-library {\n            margin-top: 3rem;\n        }\n\n        .video-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n            gap: 1.5rem;\n            margin-top: 1rem;\n        }\n\n        .video-item {\n            background: rgba(255, 255, 255, 0.03);\n            border-radius: 15px;\n            padding: 1rem;\n            transition: all 0.3s ease;\n            cursor: pointer;\n        }\n\n        .video-item:hover {\n            background: rgba(255, 255, 255, 0.05);\n            transform: translateY(-3px);\n        }\n\n        .video-thumbnail {\n            width: 100%;\n            height: 150px;\n            background: #000;\n            border-radius: 10px;\n            margin-bottom: 1rem;\n            object-fit: cover;\n        }\n\n        .video-info {\n            font-size: 0.9rem;\n            color: #9ca3af;\n        }\n\n        .import-export {\n            display: flex;\n            gap: 1rem;\n            margin: 1rem 0;\n        }\n\n        input[type=\"file\"] {\n            display: none;\n        }\n\n        .file-label {\n            display: inline-block;\n            padding: 0.8rem 2rem;\n            background: rgba(255, 255, 255, 0.1);\n            color: #e0e0e0;\n            border-radius: 50px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n        }\n\n        .file-label:hover {\n            background: rgba(255, 255, 255, 0.2);\n        }\n\n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        @keyframes fadeInDown {\n            from {\n                opacity: 0;\n                transform: translateY(-20px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(20px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes pulse {\n            0% {\n                box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.7);\n            }\n            70% {\n                box-shadow: 0 0 0 10px rgba(102, 126, 234, 0);\n            }\n            100% {\n                box-shadow: 0 0 0 0 rgba(102, 126, 234, 0);\n            }\n        }\n\n        .recording {\n            animation: pulse 2s infinite;\n        }\n\n        .stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n            gap: 1rem;\n            margin: 1rem 0;\n        }\n\n        .stat-card {\n            background: rgba(255, 255, 255, 0.03);\n            padding: 1rem;\n            border-radius: 10px;\n            text-align: center;\n        }\n\n        .stat-value {\n            font-size: 2rem;\n            font-weight: bold;\n            color: #667eea;\n        }\n\n        .stat-label {\n            font-size: 0.9rem;\n            color: #9ca3af;\n            margin-top: 0.5rem;\n        }\n\n        @media (max-width: 768px) {\n            h1 {\n                font-size: 2rem;\n            }\n            \n            .controls {\n                flex-direction: column;\n            }\n            \n            button {\n                width: 100%;\n            }\n            \n            .tabs {\n                flex-wrap: wrap;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Record & Review</h1>\n            <p class=\"subtitle\">Transform your communication skills through video analysis</p>\n        </header>\n\n        <div class=\"main-content\">\n            <div class=\"card recording-section\">\n                <h2>Step 0: Record Your Video</h2>\n                <p style=\"margin-bottom: 1rem; color: #9ca3af;\">Record a 5-minute impromptu video to analyze your communication style</p>\n                \n                <video id=\"videoElement\" autoplay muted></video>\n                <video id=\"recordedVideo\" controls style=\"display: none;\"></video>\n                \n                <div class=\"timer\" id=\"timer\">00:00</div>\n                \n                <div class=\"controls\">\n                    <button id=\"startBtn\" class=\"btn-primary\">Start Recording</button>\n                    <button id=\"stopBtn\" class=\"btn-secondary\" disabled>Stop Recording</button>\n                    <button id=\"resetBtn\" class=\"btn-secondary\" style=\"display: none;\">Record Again</button>\n                    <button id=\"analyzeBtn\" class=\"btn-primary\" style=\"display: none;\">Analyze Video</button>\n                </div>\n\n                <div class=\"import-export\">\n                    <label for=\"importVideo\" class=\"file-label\">\n                        Import Video\n                    </label>\n                    <input type=\"file\" id=\"importVideo\" accept=\"video/*\">\n                    <button id=\"exportBtn\" class=\"btn-secondary\" style=\"display: none;\">Export Video</button>\n                </div>\n            </div>\n\n            <div class=\"card analysis-section\" id=\"analysisSection\">\n                <h2>Video Analysis</h2>\n                \n                <div class=\"tabs\">\n                    <button class=\"tab active\" data-tab=\"visual\">Step 1: Visual Review</button>\n                    <button class=\"tab\" data-tab=\"vocal\">Step 2: Vocal Review</button>\n                    <button class=\"tab\" data-tab=\"transcript\">Step 3: Transcription</button>\n                </div>\n\n                <div class=\"tab-content active\" id=\"visual-tab\">\n                    <h3>Visual Image Review</h3>\n                    <p style=\"margin-bottom: 1rem; color: #9ca3af;\">Analyze your body language, facial expressions, and visual tics</p>\n                    \n                    <ul class=\"checklist\">\n                        <li>\ud83d\udc41\ufe0f <strong>Eye Contact:</strong> Are you maintaining appropriate eye contact with the camera?</li>\n                        <li>\ud83d\ude0a <strong>Facial Expressions:</strong> Do your expressions match your message?</li>\n                        <li>\ud83d\ude4c <strong>Hand Gestures:</strong> Are your gestures natural and purposeful?</li>\n                        <li>\ud83e\uddcd <strong>Posture:</strong> Is your posture confident and open?</li>\n                        <li>\ud83d\udd04 <strong>Distracting Tics:</strong> Notice any repetitive movements or habits</li>\n                    </ul>\n\n                    <textarea class=\"transcription-area\" placeholder=\"Take notes on your visual presentation...\"></textarea>\n                </div>\n\n                <div class=\"tab-content\" id=\"vocal-tab\">\n                    <h3>Vocal Image Review</h3>\n                    <p style=\"margin-bottom: 1rem; color: #9ca3af;\">Review your melody, rate of speech, volume, tonality, and use of pauses</p>\n                    \n                    <ul class=\"checklist\">\n                        <li>\ud83c\udfb5 <strong>Melody & Variation:</strong> Is your voice engaging with appropriate pitch variation?</li>\n                        <li>\u23f1\ufe0f <strong>Rate of Speech:</strong> Are you speaking too fast or too slow?</li>\n                        <li>\ud83d\udd0a <strong>Volume:</strong> Is your volume consistent and appropriate?</li>\n                        <li>\ud83c\udfad <strong>Tonality:</strong> Does your tone match your message?</li>\n                        <li>\u23f8\ufe0f <strong>Pauses:</strong> Are you using pauses effectively for emphasis?</li>\n                    </ul>\n\n                    <div class=\"stats\">\n                        <div class=\"stat-card\">\n                            <div class=\"stat-value\" id=\"avgPace\">--</div>\n                            <div class=\"stat-label\">Words/Minute</div>\n                        </div>\n                        <div class=\"stat-card\">\n                            <div class=\"stat-value\" id=\"pauseCount\">--</div>\n                            <div class=\"stat-label\">Pauses</div>\n                        </div>\n                    </div>\n\n                    <textarea class=\"transcription-area\" placeholder=\"Take notes on your vocal delivery...\"></textarea>\n                </div>\n\n                <div class=\"tab-content\" id=\"transcript-tab\">\n                    <h3>Video Transcription</h3>\n                    <p style=\"margin-bottom: 1rem; color: #9ca3af;\">Transcribe your video to identify filler words and speech patterns</p>\n                    \n                    <button id=\"transcribeBtn\" class=\"btn-primary\">Start Transcription</button>\n                    \n                    <textarea id=\"transcriptionText\" class=\"transcription-area\" placeholder=\"Your transcription will appear here...\"></textarea>\n                    \n                    <div class=\"filler-words\" id=\"fillerWords\" style=\"display: none;\">\n                        <h4>Filler Words Analysis</h4>\n                        <div id=\"fillerStats\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card video-library\">\n                <h2>Your Video Library</h2>\n                <div class=\"video-grid\" id=\"videoGrid\">\n                    <!-- Saved videos will appear here -->\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // Global variables\n        let mediaRecorder;\n        let recordedBlobs = [];\n        let videoStream;\n        let startTime;\n        let timerInterval;\n        let currentVideoBlob;\n        let recognition;\n\n        // Initialize speech recognition\n        if ('webkitSpeechRecognition' in window) {\n            recognition = new webkitSpeechRecognition();\n            recognition.continuous = true;\n            recognition.interimResults = true;\n            recognition.lang = 'en-US';\n        }\n\n        // DOM elements\n        const videoElement = document.getElementById('videoElement');\n        const recordedVideo = document.getElementById('recordedVideo');\n        const startBtn = document.getElementById('startBtn');\n        const stopBtn = document.getElementById('stopBtn');\n        const resetBtn = document.getElementById('resetBtn');\n        const analyzeBtn = document.getElementById('analyzeBtn');\n        const timer = document.getElementById('timer');\n        const analysisSection = document.getElementById('analysisSection');\n        const transcribeBtn = document.getElementById('transcribeBtn');\n        const transcriptionText = document.getElementById('transcriptionText');\n        const importVideo = document.getElementById('importVideo');\n        const exportBtn = document.getElementById('exportBtn');\n        const videoGrid = document.getElementById('videoGrid');\n\n        // Initialize the app\n        async function init() {\n            try {\n                videoStream = await navigator.mediaDevices.getUserMedia({ \n                    video: true, \n                    audio: true \n                });\n                videoElement.srcObject = videoStream;\n            } catch (err) {\n                console.error('Error accessing media devices:', err);\n                alert('Please allow camera and microphone access to use this app.');\n            }\n\n            loadVideosFromStorage();\n        }\n\n        // Start recording\n        startBtn.addEventListener('click', () => {\n            recordedBlobs = [];\n            \n            const options = { mimeType: 'video/webm' };\n            try {\n                mediaRecorder = new MediaRecorder(videoStream, options);\n            } catch (e) {\n                console.error('Error creating MediaRecorder:', e);\n                return;\n            }\n\n            mediaRecorder.ondataavailable = (event) => {\n                if (event.data && event.data.size > 0) {\n                    recordedBlobs.push(event.data);\n                }\n            };\n\n            mediaRecorder.onstop = handleStop;\n\n            mediaRecorder.start();\n            startTime = Date.now();\n            startTimer();\n\n            startBtn.disabled = true;\n            stopBtn.disabled = false;\n            videoElement.classList.add('recording');\n        });\n\n        // Stop recording\n        stopBtn.addEventListener('click', () => {\n            mediaRecorder.stop();\n            stopTimer();\n            \n            startBtn.disabled = true;\n            stopBtn.disabled = true;\n            videoElement.classList.remove('recording');\n        });\n\n        // Handle stop\n        function handleStop() {\n            const blob = new Blob(recordedBlobs, { type: 'video/webm' });\n            currentVideoBlob = blob;\n            const url = URL.createObjectURL(blob);\n            \n            videoElement.style.display = 'none';\n            recordedVideo.style.display = 'block';\n            recordedVideo.src = url;\n            \n            resetBtn.style.display = 'inline-block';\n            analyzeBtn.style.display = 'inline-block';\n            exportBtn.style.display = 'inline-block';\n            \n            // Save to local storage\n            saveVideoToStorage(blob);\n        }\n\n        // Reset recording\n        resetBtn.addEventListener('click', () => {\n            recordedVideo.style.display = 'none';\n            videoElement.style.display = 'block';\n            \n            startBtn.disabled = false;\n            stopBtn.disabled = true;\n            resetBtn.style.display = 'none';\n            analyzeBtn.style.display = 'none';\n            \n            timer.textContent = '00:00';\n            analysisSection.classList.remove('active');\n        });\n\n        // Analyze video\n        analyzeBtn.addEventListener('click', () => {\n            analysisSection.classList.add('active');\n            analysisSection.scrollIntoView({ behavior: 'smooth' });\n        });\n\n        // Timer functions\n        function startTimer() {\n            timerInterval = setInterval(() => {\n                const elapsed = Math.floor((Date.now() - startTime) / 1000);\n                const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');\n                const seconds = (elapsed % 60).toString().padStart(2, '0');\n                timer.textContent = `${minutes}:${seconds}`;\n                \n                // Auto-stop at 5 minutes\n                if (elapsed >= 300) {\n                    stopBtn.click();\n                }\n            }, 1000);\n        }\n\n        function stopTimer() {\n            clearInterval(timerInterval);\n        }\n\n        // Tab functionality\n        document.querySelectorAll('.tab').forEach(tab => {\n            tab.addEventListener('click', () => {\n                const tabName = tab.getAttribute('data-tab');\n                \n                // Update active tab\n                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\n                tab.classList.add('active');\n                \n                // Update active content\n                document.querySelectorAll('.tab-content').forEach(content => {\n                    content.classList.remove('active');\n                });\n                document.getElementById(`${tabName}-tab`).classList.add('active');\n            });\n        });\n\n        // Transcription\n        transcribeBtn.addEventListener('click', () => {\n            if (!recognition) {\n                alert('Speech recognition is not supported in your browser.');\n                return;\n            }\n\n            transcribeBtn.disabled = true;\n            transcribeBtn.textContent = 'Transcribing...';\n            \n            let finalTranscript = '';\n            \n            recognition.onresult = (event) => {\n                let interimTranscript = '';\n                \n                for (let i = event.resultIndex; i < event.results.length; i++) {\n                    const transcript = event.results[i][0].transcript;\n                    if (event.results[i].isFinal) {\n                        finalTranscript += transcript + ' ';\n                    } else {\n                        interimTranscript += transcript;\n                    }\n                }\n                \n                transcriptionText.value = finalTranscript + interimTranscript;\n            };\n\n            recognition.onerror = (event) => {\n                console.error('Speech recognition error:', event.error);\n                transcribeBtn.disabled = false;\n                transcribeBtn.textContent = 'Start Transcription';\n            };\n\n            recognition.onend = () => {\n                transcribeBtn.disabled = false;\n                transcribeBtn.textContent = 'Start Transcription';\n                analyzeFillerWords(finalTranscript);\n            };\n\n            // Play the video and start recognition\n            recordedVideo.play();\n            recognition.start();\n            \n            // Stop recognition when video ends\n            recordedVideo.onended = () => {\n                recognition.stop();\n            };\n        });\n\n        // Analyze filler words\n        function analyzeFillerWords(text) {\n            const fillerWords = ['um', 'uh', 'like', 'you know', 'so', 'actually', 'basically', 'literally', 'right'];\n            const wordCount = text.split(' ').length;\n            const fillerStats = {};\n            \n            fillerWords.forEach(filler => {\n                const regex = new RegExp(`\\\\b${filler}\\\\b`, 'gi');\n                const matches = text.match(regex);\n                if (matches) {\n                    fillerStats[filler] = matches.length;\n                }\n            });\n            \n            // Display filler word stats\n            const fillerDiv = document.getElementById('fillerWords');\n            const statsDiv = document.getElementById('fillerStats');\n            \n            fillerDiv.style.display = 'block';\n            statsDiv.innerHTML = '';\n            \n            let totalFillers = 0;\n            for (const [word, count] of Object.entries(fillerStats)) {\n                totalFillers += count;\n                const statElement = document.createElement('div');\n                statElement.style.marginBottom = '0.5rem';\n                statElement.innerHTML = `<strong>${word}:</strong> ${count} times`;\n                statsDiv.appendChild(statElement);\n            }\n            \n            const summaryElement = document.createElement('div');\n            summaryElement.style.marginTop = '1rem';\n            summaryElement.style.fontWeight = 'bold';\n            summaryElement.innerHTML = `Total filler words: ${totalFillers} (${((totalFillers / wordCount) * 100).toFixed(1)}% of speech)`;\n            statsDiv.appendChild(summaryElement);\n            \n            // Update pace statistics\n            const duration = recordedVideo.duration / 60; // in minutes\n            const wordsPerMinute = Math.round(wordCount / duration);\n            document.getElementById('avgPace').textContent = wordsPerMinute;\n        }\n\n        // Import video\n        importVideo.addEventListener('change', (event) => {\n            const file = event.target.files[0];\n            if (file && file.type.startsWith('video/')) {\n                const reader = new FileReader();\n                reader.onload = (e) => {\n                    const blob = new Blob([e.target.result], { type: file.type });\n                    currentVideoBlob = blob;\n                    const url = URL.createObjectURL(blob);\n                    \n                    videoElement.style.display = 'none';\n                    recordedVideo.style.display = 'block';\n                    recordedVideo.src = url;\n                    \n                    resetBtn.style.display = 'inline-block';\n                    analyzeBtn.style.display = 'inline-block';\n                    exportBtn.style.display = 'inline-block';\n                    \n                    saveVideoToStorage(blob);\n                };\n                reader.readAsArrayBuffer(file);\n            }\n        });\n\n        // Export video\n        exportBtn.addEventListener('click', () => {\n            if (currentVideoBlob) {\n                const url = URL.createObjectURL(currentVideoBlob);\n                const a = document.createElement('a');\n                a.href = url;\n                a.download = `recording_${new Date().toISOString()}.webm`;\n                a.click();\n                URL.revokeObjectURL(url);\n            }\n        });\n\n        // Local storage functions\n        function saveVideoToStorage(blob) {\n            const reader = new FileReader();\n            reader.onload = (e) => {\n                const videoData = {\n                    id: Date.now(),\n                    date: new Date().toISOString(),\n                    data: e.target.result,\n                    type: blob.type\n                };\n                \n                let videos = JSON.parse(localStorage.getItem('recordReviewVideos') || '[]');\n                videos.push(videoData);\n                \n                // Keep only last 10 videos to manage storage\n                if (videos.length > 10) {\n                    videos = videos.slice(-10);\n                }\n                \n                localStorage.setItem('recordReviewVideos', JSON.stringify(videos));\n                loadVideosFromStorage();\n            };\n            reader.readAsDataURL(blob);\n        }\n\n        function loadVideosFromStorage() {\n            const videos = JSON.parse(localStorage.getItem('recordReviewVideos') || '[]');\n            videoGrid.innerHTML = '';\n            \n            videos.reverse().forEach(video => {\n                const videoItem = document.createElement('div');\n                videoItem.className = 'video-item';\n                \n                const date = new Date(video.date);\n                const dateStr = date.toLocaleDateString() + ' ' + date.toLocaleTimeString();\n                \n                videoItem.innerHTML = `\n                    <video class=\"video-thumbnail\" src=\"${video.data}\"></video>\n                    <div class=\"video-info\">\n                        <strong>Recording</strong>\n                        <br>${dateStr}\n                    </div>\n                `;\n                \n                videoItem.addEventListener('click', () => {\n                    currentVideoBlob = dataURLtoBlob(video.data, video.type);\n                    videoElement.style.display = 'none';\n                    recordedVideo.style.display = 'block';\n                    recordedVideo.src = video.data;\n                    \n                    resetBtn.style.display = 'inline-block';\n                    analyzeBtn.style.display = 'inline-block';\n                    exportBtn.style.display = 'inline-block';\n                    \n                    window.scrollTo({ top: 0, behavior: 'smooth' });\n                });\n                \n                videoGrid.appendChild(videoItem);\n            });\n        }\n\n        function dataURLtoBlob(dataURL, type) {\n            const arr = dataURL.split(',');\n            const bstr = atob(arr[1]);\n            let n = bstr.length;\n            const u8arr = new Uint8Array(n);\n            while (n--) {\n                u8arr[n] = bstr.charCodeAt(n);\n            }\n            return new Blob([u8arr], { type: type });\n        }\n\n        // Initialize app\n        init();\n    </script>\n</body>\n</html>", "html_sha256": "ce623cd847af7cae21c7fdaef4542d9192ee74c4d23f0b87bb42983d6f8ec04d", "live": "https://kody-w.github.io/AINexus/record-review-app.html"}, "payload_hash": "0ae7244ccba4fb1e0091177e9fdf010fd51b03d2a4558757758502a723b0d260", "prev": null, "prev_wave": null, "sig": null, "frame_hash": "319504609179385e405748c41e4cb9e0de56c1dacc2452321e89f1971fd4a755"}
